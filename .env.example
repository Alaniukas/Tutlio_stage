#############################
# Supabase (frontend + API) #
#############################

# Public URL to your Supabase project (Project Settings → API → URL)
VITE_SUPABASE_URL=

# Public anon key for browser client (Project Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=

# Optional: same as VITE_SUPABASE_URL, used by some server-side scripts
# (you can leave empty locally if VITE_SUPABASE_URL is set)
SUPABASE_URL=

# Service role key (NEVER expose in frontend, keep only in .env)
# Used by serverless API routes, reminders, Stripe webhook, etc.
SUPABASE_SERVICE_ROLE_KEY=

################
# Stripe keys  #
################

# Secret Stripe API key (test or live)
STRIPE_SECRET_KEY=

# Price IDs for subscriptions (optional locally unless testuojam prenumeratas)
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
# Yearly one-time plan product (defaults to prod_U9DYSN7YFtsyBI in code if unset)
STRIPE_YEARLY_PRODUCT_ID=prod_U9DYSN7YFtsyBI
# "Subscription only" plan (35 EUR/month, manual payments, no commission)
# Create a recurring price in Stripe under product prod_UOWf5Nqxf1wPIg
STRIPE_SUBSCRIPTION_ONLY_PRICE_ID=
# Optional fallback if price id is not set (defaults to prod_UOWf5Nqxf1wPIg)
STRIPE_SUBSCRIPTION_ONLY_PRODUCT_ID=prod_UOWf5Nqxf1wPIg

# Enterprise self-serve licenses: recurring monthly GRADUATED tiers so totals
# never drop when adding licenses: first 10 -> €10/license, 11-20 -> €9,
# 21-30 -> €8, 31-40 -> €7, 41-50 -> €6, 50+ -> €5. The €49/mo admin fee is
# the FIRST tier's flat_amount (graduated flats apply per used band).
# The webhook syncs subscription quantity to organizations;
# /api/org-license-portal auto-provisions a Billing Portal configuration with
# quantity updates enabled (no Dashboard step).
# Live price: price_1Tgky49Ugxc4GQKmQtniND85 (product prod_Ug6zP9sgpTHyFI)
STRIPE_ENTERPRISE_PRICE_ID=
# Self-serve bounds; counts above max show "Contact us" (defaults: 1 / 200)
ENTERPRISE_MIN_LICENSES=1
ENTERPRISE_MAX_SELF_SERVE_LICENSES=200

# Stripe webhook secret (Dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=

#################################
# App URL / redirect konfiguracija
#################################

# Public app URL (prod: https://www.tutlio.lt, lokaliai: http://localhost:3000)
APP_URL=http://localhost:3000

# Vite pusėje naudojamas tas pats URL (galima palikti tuščią, jei vienodas su APP_URL)
VITE_APP_URL=http://localhost:3000

##################
# El. laiškai    #
##################

# Resend API key (production — verified tutlio.lt domain)
RESEND_API_KEY=

# Local / stage (used when RESEND_API_KEY is empty — npm run dev)
RESEND_API_KEY_STAGE=

# From adresas, kurį matys vartotojai
FROM_EMAIL=Tutlio <onboarding@tutlio.lt>

#########################
# Google Calendar OAuth #
#########################

# Google Cloud OAuth2 client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URL, turi sutapti su Google konsolėje:
# pvz. https://www.tutlio.lt/api/google-calendar-callback arba http://localhost:3000/api/google-calendar-callback
GOOGLE_REDIRECT_URI=

########################
# Vidiniai / admin raktai
########################

# Platform admin API (tik serveris / Vercel — NIEKADA ne VITE_*). Senas VITE_ADMIN_SECRET vis dar skaitomas migracijai.
ADMIN_SECRET=
# @deprecated Naudokite ADMIN_SECRET. Jei vis dar nustatyta, API priims ir šį.
# VITE_ADMIN_SECRET=

################################
# Pamokų lankomumo sekimas     #
################################

# HMAC raktas sekamoms "prisijungti prie pamokos" nuorodoms laiškuose
# (/api/join-session). Nebūtinas — jei tuščias, naudojamas SUPABASE_SERVICE_ROLE_KEY.
JOIN_LINK_SECRET=

########################
# Vercel Cron apsauga  #
########################

# Vercel automatiškai nustato CRON_SECRET production aplinkoje.
# PRIVALOMA deployed aplinkose: jei VERCEL_ENV nustatytas, o CRON_SECRET tuščias,
# cron endpointai grąžina 500 (fail closed). Lokaliai galima palikti tuščią.
CRON_SECRET=

##############################
# Auto SEO blog generation   #
##############################

# Provider: "custom" (default) or "gemini" for local testing with GEMINI_API_KEY
# BLOG_AI_PROVIDER=gemini
# Custom AI API (POST JSON — see docs/seo-deploy-checklist-tutlio-pl.md)
BLOG_AI_API_URL=
BLOG_AI_API_KEY=
# Optional separate cover-image endpoint if text API does not return cover_image_*
BLOG_AI_IMAGE_URL=
# HMAC secret for one-click publish links in admin emails (falls back to SUPABASE_SERVICE_ROLE_KEY)
BLOG_PUBLISH_SECRET=
# Comma-separated override for draft-ready notifications (default: internal team emails)
# BLOG_NOTIFY_EMAILS=

######################
# PerlasFinance      #
######################

# PerlasFinance project ID (integer, provided by PerlasPay team)
PROJECT_ID=

# PerlasFinance API key / personal hash (used for JWT signing and AES encryption)
PERLASFINANCE_API_KEY=

########################
# Papildomi (nebūtini) #
########################

# Gemini blog generation (local test: BLOG_AI_PROVIDER=gemini + GEMINI_API_KEY)
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
# Cover image model (default tries gemini-2.5-flash-image)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# DOCX → PDF (sutartys): Railway / kitas servisas, suderinamas su tutlio-docx-converter
# (POST /convert-docx-to-pdf, Authorization: Bearer <key>, body: { fileBase64 })
DOCX_CONVERTER_URL=
DOCX_CONVERTER_API_KEY=

# Atsarginis komercinis fallback (ConvertAPI.com), jei nėra hosted converter / LibreOffice
# CONVERTAPI_SECRET=

# Lokalus LibreOffice (nebūtina ant Vercel jei naudojate DOCX_CONVERTER_*)
# LIBREOFFICE_PATH=

